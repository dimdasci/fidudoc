{
  "name": "@fidudoc/monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @fidudoc/app dev",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "pnpm lint && pnpm format:check",
    "check:fix": "pnpm lint:fix && pnpm format",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r run clean"
  },
  "keywords": [],
  "author": "Dim Kharitonov <dimds@fastmail.com>",
  "license": "Copyright",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
