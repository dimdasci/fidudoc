{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @fidudoc/app build",
    "watchPatterns": ["packages/app/**", "packages/domain/**"]
  },
  "deploy": {
    "startCommand": "cd packages/app && caddy run --config Caddyfile --adapter caddyfile 2>&1",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
