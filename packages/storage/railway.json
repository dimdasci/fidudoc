{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @fidudoc/storage build",
    "watchPatterns": ["packages/storage/**", "packages/domain/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @fidudoc/storage start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health"
  }
}
