{
  "name": "@fidudoc/storage",
  "version": "1.0.0",
  "private": true,
  "description": "Storage Component",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:fix": "pnpm typecheck && pnpm lint:fix && pnpm format",
    "build": "tsc && tsup src/index.ts --no-dts --format esm",
    "start": "NODE_OPTIONS='--import ./instruments.mjs' node dist/index.js",
    "dev": "NODE_OPTIONS='--import ./instruments.mjs' tsx --watch src/index.ts"
  },
  "keywords": [],
  "author": "Dim Kharitonov <dimds@fastmail.com>",
  "license": "Copyright",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@effect/experimental": "^0.56.0",
    "@effect/language-service": "^0.46.0",
    "@effect/platform": "^0.92.1",
    "@effect/platform-node": "^0.98.4",
    "@effect/sql": "^0.46.0",
    "@effect/sql-pg": "^0.47.0",
    "@sentry/node": "^10.20.0",
    "@supabase/supabase-js": "^2.76.1",
    "casbin": "^5.40.0",
    "casbin-basic-adapter": "^1.3.0",
    "cors": "^2.8.5",
    "effect": "^3.18.4",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "pg": "^8.16.3",
    "ulid": "^3.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.26.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.5",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
