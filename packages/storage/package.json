  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@effect/language-service": "^0.46.0",
    "@sentry/node": "^10.20.0",
    "effect": "^3.18.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.26.0",
    "@types/express": "^5.0.3",
    "vitest": "^3.2.4"
  }
